rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userCompanyId() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.company_id
        : null;
    }

    function sameCompany(companyId) {
      return signedIn() && (userCompanyId() == companyId || companyOwner(companyId));
    }

    function companyOwner(companyId) {
      return signedIn() && exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId)).data.owner_uid == request.auth.uid;
    }

    // User profiles are provisioned and updated by the verified Express API.
    // A browser may read only its own profile; all client-side writes are denied.
    match /users/{uid} {
      allow read: if ownUser(uid);
      allow create, update, delete: if false;
    }

    // Company records are owned by the server. A tenant member can read only
    // their own company record, never enumerate or alter another company.
    match /companies/{companyId} {
      allow read: if sameCompany(companyId);
      allow create, update, delete: if false;
    }

    // The worker queue and schedules are server-owned. A client can inspect
    // records only when their immutable company_id matches the verified user.
    match /workforce_jobs/{jobId} {
      allow read: if signedIn() && resource.data.company_id == userCompanyId();
      allow create, update, delete: if false;
    }

    match /scheduled_workflows/{workflowId} {
      allow read: if signedIn() && resource.data.company_id == userCompanyId();
      allow create, update, delete: if false;
    }

    // Payment records are exposed through the authenticated API only. This
    // rule permits a tenant-scoped read but prevents any browser mutation.
    match /payments/{paymentId} {
      allow read: if signedIn() && resource.data.company_id == userCompanyId();
      allow create, update, delete: if false;
    }

    // All tenant subcollections—including tasks, approvals, conversations,
    // memory, audit evidence, connectors, and Hermes draft artifacts—are
    // readable only by the verified member of the matching company. The
    // Express service uses Firebase Admin and remains the exclusive writer.
    match /tenants/{companyId}/{collection}/{documentId} {
      allow read: if sameCompany(companyId);
      allow create, update, delete: if false;
    }

    // Retain the same restrictive boundary for legacy company subcollections.
    match /companies/{companyId}/{collection}/{documentId} {
      allow read: if sameCompany(companyId);
      allow create, update, delete: if false;
    }
  }
}
